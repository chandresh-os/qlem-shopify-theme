    "help_faq_JPyUYx": {
      "type": "help-faq",
      "blocks": {
        "tab_1_block_MEdb4g": {
          "type": "tab_1_block",
          "settings": {
            "que1": "1. How do I activate my card?",
            "desc1": "Card is already activated. Just login with your credentials in web dashboard or Add card in your QLEM app."
          }
        },
        "tab_1_block_CQLf9Q": {
          "type": "tab_1_block",
          "settings": {
            "que1": "2. How do I reset my card’s settings?",
            "desc1": "Log into your QLEM app or dashboard, and update the card profile. Changes will sync automatically."
          }
        },
        "tab_1_block_XU6NK9": {
          "type": "tab_1_block",
          "settings": {
            "que1": "3. What happens if I change my phone number or email?",
            "desc1": "Simply log into your QLEM app or dashboard and update your details in the \"Edit Profile\" section. The changes will be reflected instantly on your card."
          }
        },
        "tab_1_block_ktVLJC": {
          "type": "tab_1_block",
          "settings": {
            "que1": "4. Can I share specific social media accounts only?",
            "desc1": "Yes, in the \"Edit Profile\" section, you can choose which social media links to share and hide others based on your preferences."
          }
        },
        "tab_1_block_ePf4GM": {
          "type": "tab_1_block",
          "settings": {
            "que1": "5. Can I add additional links like my portfolio or website?",
            "desc1": "Yes, QLEM allows you to add custom links such as personal websites, blogs, or portfolios to showcase your work."
          }
        },
        "tab_1_block_8N8RYw": {
          "type": "tab_1_block",
          "disabled": true,
          "settings": {
            "que1": "6. How long does the card last?",
            "desc1": "It’s durable and reusable for years with proper care."
          }
        },
        "tab_2_block_kHN8dr": {
          "type": "tab_2_block",
          "settings": {
            "que2": "1. What is a QLEM NFC card?",
            "desc2": "It’s a reusable smart business card that shares your contact info with a tap or Scan QR."
          }
        },
        "tab_2_block_bXtP3j": {
          "type": "tab_2_block",
          "settings": {
            "que2": "2. How does it work?",
            "desc2": "Tap the card on an NFC-enabled smartphone to share your details instantly. or Scan QR for Non-NFC devices"
          }
        },
        "tab_2_block_a6ULwg": {
          "type": "tab_2_block",
          "settings": {
            "que2": "3. Do I need an app?",
            "desc2": "No app is needed to receive info, but you can customize your profile via the QLEM app and Web dashboard"
          }
        },
        "tab_2_block_jg66Uh": {
          "type": "tab_2_block",
          "settings": {
            "que2": "4. Can I update my card details?",
            "desc2": "Yes, update anytime using the QLEM app or web dashboard."
          }
        },
        "tab_2_block_cVctyF": {
          "type": "tab_2_block",
          "settings": {
            "que2": "5. Is my data secure?",
            "desc2": "Yes, only the information you set is shared securely."
          }
        },
        "tab_2_block_Wp7b7P": {
          "type": "tab_2_block",
          "settings": {
            "que2": "6. How long does the card last?",
            "desc2": "It’s durable and reusable for years with proper care. If you want to buy again only card then you have to pay only physical card cost."
          }
        },
        "tab_2_block_FiwGeH": {
          "type": "tab_2_block",
          "settings": {
            "que2": "7. How do I order a card?",
            "desc2": "Order through our website, customize, and checkout."
          }
        },
        "tab_3_block_H3nTUQ": {
          "type": "tab_3_block",
          "settings": {
            "que3": "1. Is it compatible with all devices?",
            "desc3": "Yes, It works with most NFC-enabled smartphones (Android and iPhones 7+). and for Non-NFC phone users can scan QR to get same information."
          }
        },
        "tab_3_block_GJeUhJ": {
          "type": "tab_3_block",
          "settings": {
            "que3": "2. What if a phone doesn’t support NFC?",
            "desc3": "A QR code on the card can be scanned instead."
          }
        },
        "tab_3_block_RQ87w4": {
          "type": "tab_3_block",
          "disabled": true,
          "settings": {
            "que3": "Various versions have evolved over the years, sometimes by accident.",
            "desc3": "It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout. The point of using Lorem Ipsum \nis that it has a more-or-less normal distribution of letters, as opposed to using 'Content here, content here’"
          }
        },
        "tab_4_block_4tCYMr": {
          "type": "tab_4_block",
          "settings": {
            "que4": "1. Can I track my order?",
            "desc4": "Yes, once your order is shipped, you will receive a tracking number via email and whatsapp to monitor its progress."
          }
        },
        "tab_4_block_yn63Qb": {
          "type": "tab_4_block",
          "settings": {
            "que4": "2. How much does shipping cost?",
            "desc4": "Shipping costs depend on your location and the number of cards ordered. The final shipping cost will be calculated during checkout."
          }
        },
        "tab_4_block_V9hkLz": {
          "type": "tab_4_block",
          "settings": {
            "que4": "3. What’s your return policy?",
            "desc4": "Returns are accepted for damaged products within 2 days."
          }
        },
        "tab_4_block_aRDryT": {
          "type": "tab_4_block",
          "settings": {
            "que4": "4. Do you ship internationally?",
            "desc4": "Yes, shipping costs and times depend on your location."
          }
        }
      },
