    "about_img_text_Nhj43z": {
      "type": "about-img-text",
      "settings": {
        "bg_color": "#081626",
        "image": "shopify://shop_images/About_Img_ff884071-970e-4e16-a275-a840821ade33.png",
        "title": "About Us",
        "desc": "<p>At QLEM, we believe that connections are the cornerstone of every successful relationship, whether in business or personal life. Our journey began with a bold vision: to revolutionize traditional business cards by creating a dynamic, sustainable, and innovative digital solution. Today, we proudly extend that vision through our premium <strong>QLEM NFC cards</strong>—a physical product designed to seamlessly bridge the gap between the digital and physical worlds.</p><p></p>",
        "btn_url": "https://qlem.co/pages/create-your-free-qr",
        "btn_text": "Create Your Free QR"
      }
    },
    "pvc_section_AehV3J": {
      "type": "PVC-section",
      "settings": {
        "title": "Who We are",
        "subtext": "QLEM is the flagship brand of Pixigo Innovation Private Limited, a forward-thinking company officially recognized under the Startup India initiative. As a certified startup, we are committed to fostering innovation and delivering cutting-edge solutions that empower professionals.",
        "heading": "Why Choose QLEM?",
        "desc": "Certified Innovation: As a Startup India-recognized company, our solutions reflect quality and forward-thinking innovation.\nBridging Digital and Physical: QLEM NFC cards offer seamless sharing of information with a simple tap, eliminating the need for traditional paper cards.\nSustainability at Heart: One QLEM NFC card replaces countless paper business cards, reducing waste and promoting eco-friendly networking.\nCustom Solutions: Whether you’re an individual or a corporate entity, we provide tailored products to meet your unique needs.",
        "btn_url": "https://qlem.co/pages/create-your-free-qr",
        "btn_text": "Download QLEM App",
        "image": "shopify://shop_images/qlemcard.png"
      }
    },
