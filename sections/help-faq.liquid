<script>
      function openFAQ(evt, questionName) {
        var i, tabcontent, tablinks;

        // Hide all tab content by default
        tabcontent = document.getElementsByClassName("tabcontent");
        for (i = 0; i < tabcontent.length; i++) {
          tabcontent[i].style.display = "none";
        }

        // Remove active class from all tab links
        tablinks = document.getElementsByClassName("tablinks");
        for (i = 0; i < tablinks.length; i++) {
          tablinks[i].className = tablinks[i].className.replace(" active", "");
        }

        // Show the clicked tab and mark it as active
        document.getElementById(questionName).style.display = "block";
        evt.currentTarget.className += " active";
      }

      // Set the first tab to be open by default
      document.getElementById("defaultOpen").click();


  $(document).ready(function() {

      $('.help_faq_col').on('click', function() {
          if ($(this).hasClass('active')) {
              $(this).removeClass('active');
          } else {
              $('.help_faq_desc').slideUp(); // Close all open descriptions
              $('.help_faq_col').removeClass('active'); // Remove active state from all
              $(this).toggleClass('active'); // Toggle active state of clicked FAQ
          }
      });


  });

