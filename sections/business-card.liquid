        },
        {
          "type": "textarea",
          "id": "svgicon2",
          "label": "Add SVG Content"
        },
        {
          "type": "text",
          "id": "title2",
          "label": "Add Title"
        },
        {
          "type": "textarea",
          "id": "subtext2",
          "label": "Add Sub Text"
        },
        {
          "type": "header",
          "content": "Add Block Info 3"
        },
        {
          "type": "textarea",
          "id": "svgicon3",
          "label": "Add SVG Content"
        },
        {
          "type": "text",
          "id": "title3",
          "label": "Add Title"
        },
        {
          "type": "textarea",
          "id": "subtext3",
          "label": "Add Sub Text"
        },
