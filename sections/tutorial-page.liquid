<script>
    $(document).ready(function() {
    // Main tab click
    $('.main-tab').click(function() {
      var mainTab = $(this).data('main-tab');

      // Set active state for main tabs
      $('.main-tab').removeClass('active');
      $(this).addClass('active');

      // Show corresponding sub-tab container and hide others
      $('.sub-tab-container').hide();
      $('.sub-tab-container[data-main-tab="' + mainTab + '"]').show();

      // Reset sub-tab active states
      $('.sub-tab').removeClass('active');
      $('.sub-tab-container[data-main-tab="' + mainTab + '"] .sub-tab:first').addClass('active');

      // Show the first sub-tab content by default
      $('.sub-tab-content').hide();
      $('.sub-tab-container[data-main-tab="' + mainTab + '"] .sub-tab-content:first').show();
    });

    // Sub-tab click
    $('.sub-tab').click(function() {
      var subTab = $(this).data('sub-tab');

      // Set active state for sub-tabs
      $(this).siblings().removeClass('active');
      $(this).addClass('active');

      // Show corresponding sub-tab content and hide others
      $(this).closest('.sub-tab-container').find('.sub-tab-content').hide();
      $(this).closest('.sub-tab-container').find('.sub-tab-content[data-sub-tab="' + subTab + '"]').show();
    });
  });
</script>
