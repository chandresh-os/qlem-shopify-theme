<div class="mobile-txt-img p-80" style="background:{{ section.settings.bg_color }}">
  <div class="container">
    <div class="mobile-txt-img-inner">
      {% if section.settings.title != blank %}
        <h2 class="title-40 t-center">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.desc != blank %}
        <p class="f-20 t-center">{{ section.settings.desc }}</p>
      {% endif %}
    </div>
    <div class="mobile-images d-flex">
      {% for block in section.blocks %}
        <div class="mobile-col">
          {% if block.settings.bg_img != blank %}
            <img src="{{ block.settings.bg_img | img_url: "master" }}" class="w-100">
          {% endif %}
          {% if block.settings.title != blank %}
            <h4>{{ block.settings.title }}</h4>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Monile Text Image Section",
  "settings": [
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color"
      },
       {
        "type": "text",
        "id": "title",
        "label": "Add Title"
      },
      {
        "type": "textarea",
        "id": "desc",
        "label": "Add Description"
      }
  ],
    "blocks": [
      {
        "type": "block",
        "name":"Block",
        "settings": [
          {
            "type": "image_picker",
            "id": "bg_img",
            "label": "Add Image"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Add Text"
          }
        ]
      }
    ],
  "presets": [
    {
      "name": "Monile Text Image Section"
    }
  ]
}
{% endschema %}
