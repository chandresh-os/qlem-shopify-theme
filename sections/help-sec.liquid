<section>
  <div class="help_sec mb-80">
    <div class="container">
      <div class="help_inner">
          {% if section.settings.title != blank %}
          <h2 class="title-40  t-center">{{ section.settings.title }}</h2>
          {% endif %}
          {% if section.settings.desc != blank %}
          <p class="f-20  t-center">{{ section.settings.desc }}</p>
          {% endif %}
        <div class="help_flex">
        {% for block in section.blocks %}
          <div class="help_wrapper">
            <div class="help_box br-8">
              <div class="help_box_flex">
                <div class="help_icon">
                  <span class="br-8">{{ block.settings.icon }}</span>
                </div>
                <div class="help_title">
                  {% if block.settings.help_title != blank %}
                  <h4>{{ block.settings.help_title }}</h4>
                  {% endif %}
                </div>
              </div>
              {% if block.settings.help_desc != blank %}
              <p>{{ block.settings.help_desc }}</p>
              {% endif %}
              {% if block.settings.btn_text != blank %}
              <a href="{{ block.settings.btn_url }}">
                {{ block.settings.btn_text }}
              </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>












{% schema %}
  {
    "name": "Help Sec",
    "settings": [
       {
        "type": "text",
        "id": "title",
        "label": "Add Title"
      },
      {
        "type": "textarea",
        "id": "desc",
        "label": "Add Description"
      }
    ],
    "blocks": [
      {
        "type": "help_box",
        "name":"Help Box",
        "settings": [
          {
            "type": "html",
            "id": "icon",
            "label": "Add Icon"
          },
          {
            "type": "text",
            "id": "help_title",
            "label": "Add Title"
          },
          {
            "type": "textarea",
            "id": "help_desc",
            "label": "Add Description"
          },
          {
            "type": "text",
            "id": "btn_text",
            "label": "Add Button Text"
          },
          {
            "type": "url",
            "id": "btn_url",
            "label": "Add Button Url"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Help Sec"
      }
    ]
  }
{% endschema %}