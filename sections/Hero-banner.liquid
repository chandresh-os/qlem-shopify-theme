<div class="hero-section" style="background-image: url({{ section.settings.mainimg | img_url: "master" }})">
  <div class="container">
    <div class="d-flex hero-section-inner">
      <div class="hero-left">
        {% if section.settings.title != blank %}
          <h1>{{ section.settings.title }}</h1>
        {% endif %}
        {% if section.settings.desc != blank %}
          <p>{{ section.settings.desc }}</p>
        {% endif %}
        {% if section.settings.btntext != blank %}
          <a class="started-button" href="{{ section.settings.btnurl }}">
            <svg width="50" height="50" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="25" cy="25" r="25" fill="white"/>
              <g clip-path="url(#clip0_1_236)">
              <path d="M35.1933 23.0843L31.6458 19.5002C31.5606 19.4142 31.4592 19.346 31.3475 19.2995C31.2358 19.253 31.116 19.229 30.995 19.229C30.874 19.229 30.7542 19.253 30.6425 19.2995C30.5308 19.346 30.4294 19.4142 30.3442 19.5002C30.1734 19.6719 30.0776 19.9042 30.0776 20.1464C30.0776 20.3886 30.1734 20.6209 30.3442 20.7927L33.6075 24.0835H14.9167C14.6736 24.0835 14.4404 24.1801 14.2685 24.352C14.0966 24.5239 14 24.757 14 25.0002V25.0002C14 25.2433 14.0966 25.4764 14.2685 25.6483C14.4404 25.8202 14.6736 25.9168 14.9167 25.9168H33.6625L30.3442 29.226C30.2583 29.3112 30.1901 29.4126 30.1435 29.5243C30.097 29.636 30.073 29.7558 30.073 29.8768C30.073 29.9978 30.097 30.1176 30.1435 30.2293C30.1901 30.3411 30.2583 30.4424 30.3442 30.5277C30.4294 30.6136 30.5308 30.6818 30.6425 30.7283C30.7542 30.7748 30.874 30.7988 30.995 30.7988C31.116 30.7988 31.2358 30.7748 31.3475 30.7283C31.4592 30.6818 31.5606 30.6136 31.6458 30.5277L35.1933 26.971C35.7083 26.4554 35.9976 25.7564 35.9976 25.0277C35.9976 24.2989 35.7083 23.5999 35.1933 23.0843Z" fill="#28C0F1"/>
              </g>
              <defs>
              <clipPath id="clip0_1_236">
              <rect width="22" height="22" fill="white" transform="translate(14 14)"/>
              </clipPath>
              </defs>
            </svg>
            {{ section.settings.btntext -}}
          </a>
        {% endif %}
      </div>
      <div class="hero-right">
        <img src="{{ section.settings.img | img_url: "master" }}">
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "mainimg",
      "label": "Add Background Image"
    },
    {
      "type": "image_picker",
      "id": "img",
      "label": "Add Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Add Title"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Add Description"
    },
    {
      "type": "text",
      "id": "btntext",
      "label": "Add Button Title"
    },
    {
      "type": "url",
      "id": "btnurl",
      "label": "Add Button URL"
    }
  ],
  "presets": [
    {
      "name": "Hero Section"
    }
  ]
}
{% endschema %}
